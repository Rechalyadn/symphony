# esac

# # Set the release to load code on demand (interactive) instead of preloading (embedded).
# export RELEASE_MODE=interactive

# # Set the release to work across nodes.
# # RELEASE_DISTRIBUTION must be "sname" (local), "name" (distributed) or "none".
# export RELEASE_DISTRIBUTION=name
# export RELEASE_NODE=<%= @release.name %>

# Prompts, workflow files and job output are UTF-8. A service manager starts
# with an empty locale, where the VM falls back to latin1 file names and child
# processes (codex, job shells) inherit the C locale. Pin both.
export LANG="${LANG:-C.UTF-8}"
export ELIXIR_ERL_OPTIONS="+fnu ${ELIXIR_ERL_OPTIONS:-}"
