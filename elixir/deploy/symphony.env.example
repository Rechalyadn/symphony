# Copied to ~/.config/symphony/env by deploy/install.sh (mode 600).
# systemd reads it verbatim: no quotes, no $VAR expansion, no ~.

# Linear personal API key. Symphony keeps it; codex never sees it.
LINEAR_API_KEY=lin_api_REPLACE_ME

# The workflow to run, e.g. a filled-in copy of WORKFLOW.quant.md.
SYMPHONY_WORKFLOW=/home/REPLACE_ME/.config/symphony/WORKFLOW.md

# Logs land in $SYMPHONY_LOGS_ROOT/log/symphony.log.1 (rotated 10MB x 5).
SYMPHONY_LOGS_ROOT=/home/REPLACE_ME/.local/state/symphony
